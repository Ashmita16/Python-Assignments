2. TUPLE
A tuple is an immutable ordered collection of elements.
a. Tuples are similar to lists, but unlike lists, they cannot be changed after their creation.
b. Tuples can hold elements of different data types.
c. These are ordered, heterogeneous and immutable.

The code example for Tuple is given below:

# 1. CREATING A TUPLE USING PARENTHESES

print("1. Creating Tuple Using Parentheses")
numbers = (10, 20, 30, 40)
fruits = ("mango", "orange", "grapes")
print("Numbers:", numbers)
print("Fruits:", fruits)


# 2. CREATING A TUPLE WITHOUT PARENTHESES

print("\n2. Creating Tuple Without Parentheses")
numbers = 5, 10, 15, 20
names = "Ashmita", "Mousumi", "Pinki"
print("Numbers:", numbers)
print("Names:", names)

# 3. CREATING A TUPLE USING tuple() CONSTRUCTOR

print("\n3. Creating Tuple Using tuple() Constructor")
numbers = tuple([10, 20, 30, 40])
letters = tuple("Python")
print("Tuple from list:", numbers)
print("Tuple from string:", letters)


# 4. CREATING A TUPLE WITH ONE ELEMENT

print("\n4. Creating Tuple With One Element")

number = (50,)
name = ("Ashmita",)
print("Single number tuple:", number)
print("Single name tuple:", name)

# 5. TUPLE WITH MULTIPLE DATA TYPES

print("\n5. Tuple With Multiple Data Types")
data = (100, "Python", 3.14, True)
print("First element:", data[0])
print("Complete tuple:", data)


# 6. ACCESSING ELEMENTS USING INDEXING

print("\n6. Accessing Elements")
marks = (75, 82, 91, 68)
print("First mark:", marks[0])
print("Last mark:", marks[-1])

# 7. NEGATIVE INDEXING

print("\n7. Negative Indexing")
colors = ("red", "blue", "green", "yellow")
print("Last color:", colors[-1])

# 8. TUPLE SLICING


print("\n8. Tuple Slicing")
numbers = (10, 20, 30, 40, 50, 60)
print("Reverse:", numbers[::-1])

# 9. ITERATING OVER A TUPLE

print("\n9. Iterating Over Tuple")
subjects = ("Python", "Java", "SQL")
for subject in subjects:
    print(subject)

# 10. count()

print("\n10. count() Method")
numbers = (10, 20, 20, 30, 20, 40)
print("Number of times 20 occurs:", numbers.count(20))

# 11. index()

print("\n11. index() Method")
fruits = ("apple", "mango", "banana", "orange")
print("Index of banana:", fruits.index("banana"))

# 12. CHECKING ELEMENT USING in

print("\n12. Checking Element")
fruits = ("apple", "banana", "mango")
if "mango" in fruits:
    print("Mango is present in the tuple")
else:
    print("Mango is not present in the tuple")

# 13. CONCATENATING TWO TUPLES

print("\n13. Concatenating Tuples")
tuple1 = ("Python", "Java")
tuple2 = ("C++", "JavaScript")
combined = tuple1 + tuple2
print("Combined tuple:", combined)

# 14. TUPLE REPETITION

print("\n14. Tuple Repetition")
numbers = (1, 2, 3)
repeated = numbers * 2
print("Repeated tuple:", repeated)

# 15. LENGTH OF TUPLE

print("\n15. len() Function")
numbers = (10, 20, 30, 40, 50)
print("Number of elements:", len(numbers))

# 16. min(), max() AND sum()

print("\n16. min(), max() and sum()")
marks = (75, 82, 91, 68, 88)
print("Minimum mark:", min(marks))
print("Maximum mark:", max(marks))
print("Total marks:", sum(marks))

# 17. NESTED TUPLE

print("\n17. Nested Tuple")
students = (
    ("Ashmita", 85),
    ("Mousumi", 92),
    ("Pinky", 78)
)
print("First student:", students[0])
print("Name of second student:", students[1][0])
print("Marks of second student:", students[1][1])

# 18. TUPLE UNPACKING

print("\n18. Tuple Unpacking")
student = ("Ashmita", 85, "CSE")
name, marks, course = student
print("Name:", name)
print("Marks:", marks)
print("Course:", course)

# 19. CONVERTING TUPLE TO LIST

print("\n19. Converting Tuple to List")
numbers = (10, 20, 30, 40)
number_list = list(numbers)
print("Original tuple:", numbers)
print("Converted list:", number_list)


# 20. CONVERTING LIST TO TUPLE

print("\n20. Converting List to Tuple")
numbers = [10, 20, 30, 40]
number_tuple = tuple(numbers)
print("Original list:", numbers)
print("Converted tuple:", number_tuple)

# 21. IMMUTABILITY OF TUPLE

print("\n21. Tuple Immutability")
numbers = (10, 20, 30)
print("Original tuple:", numbers)
# Tuples cannot be modified directly.
# The following line would produce an error:
#
# numbers[1] = 25

