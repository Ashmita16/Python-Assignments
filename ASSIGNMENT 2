#QUESTION 2: Write a Python program to create your own version of copy.deepcopy method 


def my_deepcopy(data):
    if isinstance(data, list):
        new_list = []
        for item in data:
            new_list.append(my_deepcopy(item))
        return new_list
    elif isinstance(data, dict):
        new_dict = {}
        for key, value in data.items():
            new_dict[my_deepcopy(key)] = my_deepcopy(value)
        return new_dict
    else:
        return data

# SAMPLE EXAMPLE

original = {
    "name": "Ashmita",
    "marks": [80, 85, 90],
    "details": {
        "course": "CSE",
        "year": 2026
    }
}
copied = my_deepcopy(original)
print("Original:", original)
print("Copied:", copied)
copied["marks"][0] = 100
copied["details"]["year"] = 2027
print("\nAfter modifying copied dictionary:")
print("Original:", original)
print("Copied:", copied)

