questions = [
    {
        "question": "What is Python?",
        "options": ["Language", "Database", "OS", "Browser"],
        "answer": 1
    },
    {
        "question": "Which symbol is used for comments in Python?",
        "options": ["//", "#", "/*", "--"],
        "answer": 2
    },
    {
        "question": "Which of these is a Python collection?",
        "options": ["List", "Class", "Function", "Module"],
        "answer": 1
    },
    {
        "question": "What is the output type of input() in Python?",
        "options": ["Integer", "Float", "String", "Boolean"],
        "answer": 3
    },
    {
        "question": "Which keyword is used for a loop?",
        "options": ["repeat", "for", "loop", "iterate"],
        "answer": 2
    },

]


def display_question(question_number):
    question = questions[question_number]

    print("\nQuestion", question_number + 1)
    print(question["question"])

    for i, option in enumerate(question["options"], start=1):
        print(i, ".", option)


def get_answer():
    while True:
        try:
            answer = int(input("Enter your answer: "))

            if answer < 1 or answer > 4:
                raise ValueError("Answer must be between 1 and 4")

            return answer

        except ValueError as e:
            print("Invalid answer")


def check_answer(question, answer):
    return answer == question["answer"]


def calculate_score(correct, total):
    return (correct / total) * 100


def main():
    correct = 0

    for i in range(len(questions)):

        display_question(i)

        answer = get_answer()

        if check_answer(questions[i], answer):
            print("Correct")
            correct += 1
        else:
            print("Wrong")

    total = len(questions)
    wrong = total - correct
    score = calculate_score(correct, total)
    print("Total Questions:", total)
    print("Correct:", correct)
    print("Wrong:", wrong)
    print("Score:", score, "%")


main()

