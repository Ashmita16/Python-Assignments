def is_prime(number):
    if number < 2:
        return False
    for divisor in range(2, int(number ** 0.5) + 1):
        if number % divisor == 0:
            return False
    return True
def is_even(number):
    return number % 2 == 0
def is_odd(number):
    return number % 2 != 0
def get_factors(number):
    factors = []
    for divisor in range(1, number + 1):
        if number % divisor == 0:
            factors.append(divisor)
    return factors
def get_prime_factors(number):
    prime_factors = []
    for factor in get_factors(number):
        if is_prime(factor):
            prime_factors.append(factor)
    return prime_factors
def analyze_number(number):
    print(f"\nNumber: {number}")
    if number < 0:
        print("It is a negative number")
        number = abs(number)
    else:
        print("It is not a negative number")
    if number == 0:
        print("It is an even number")
        print("it is not an odd number")
        print("It is not a prime number")
        print("Factors are not defined for zero")
        print("Prime Factors are not defined for zero")
        return
    if number == 1:
        print("It is not an even number")
        print("It is an even number")
        print("It is not a prime number")
        print("Factors: [1]")
        print("Prime Factors: []")
        return
    print(f"Even: {'Yes' if is_even(number) else 'No'}")
    print(f"Odd: {'Yes' if is_odd(number) else 'No'}")
    print(f"Prime: {'Yes' if is_prime(number) else 'No'}")
    print(f"Factors: {get_factors(number)}")
    print(f"Prime Factors: {get_prime_factors(number)}")
def main():
    try:
        number = int(input("Enter number: "))
        analyze_number(number)
    except ValueError:
        print("Please enter a valid integer")
if __name__ == "__main__":
    main()
