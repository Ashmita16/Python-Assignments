import asyncio
import random
import time
async def process_job(job_id: int):
    print(f"Job {job_id} started")
    duration = random.uniform(1, 3)
    await asyncio.sleep(duration)
    
    print(f"Job {job_id} completed")
    return job_id
async def run_jobs(jobs: list):
    start_time = time.perf_counter()
    semaphore = asyncio.Semaphore(3)

    async def worker(job_id):
        async with semaphore:
            return await process_job(job_id)
    results = await asyncio.gather(*(worker(job) for job in jobs))
    end_time = time.perf_counter()
    print(f"Total execution time: {end_time - start_time:.2f} seconds")
    
    return results
jobs = list(range(1, 21))
completed_job_ids = asyncio.run(run_jobs(jobs))
print(f"Completed Jobs: {completed_job_ids}")

